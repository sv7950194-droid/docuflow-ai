# Database Credentials (MySQL default, SQLite fallback if unreachable)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=docuflow_db
DB_USER=root
DB_PASSWORD=rootpassword

# AI API Key (Gemini, OpenAI, or compatible provider)
AI_API_KEY=

# Decision Engine Thresholds
CONFIDENCE_APPROVED_THRESHOLD=90.0
CONFIDENCE_REVIEW_THRESHOLD=60.0

# Server Config
UPLOAD_DIR=backend/uploads
MAX_FILE_SIZE_MB=25
